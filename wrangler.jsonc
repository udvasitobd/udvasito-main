// Cloudflare Workers config for the web app (ADR-024). Built and deployed by Workers Builds from GitHub.
// Top level = PRODUCTION: Worker "udvasito-web", branch `main`, https://udvasito.com.
// `env.staging` = STAGING: Worker "udvasito-web-staging", branch `staging`, https://staging.udvasito.com, plus preview
// URLs for other branches. Only public values here — secrets live in the Cloudflare dashboard (CLAUDE.md rule 18).
{
  "name": "udvasito-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    // `npm run build:web` (expo export) writes the site here; `public/_headers` sets CSP and other headers.
    "directory": "./dist",
    // Expo Router web output is one index.html (app.config.ts `web.output: 'single'`).
    "not_found_handling": "single-page-application",
    // Only these paths run worker/index.ts; every other request is a free static-asset request.
    "run_worker_first": ["/api/*"],
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "udvasito.com", "custom_domain": true },
    // www is redirected to udvasito.com by a zone Redirect Rule (dashboard), which runs before the Worker.
    { "pattern": "www.udvasito.com", "custom_domain": true },
  ],
  "vars": { "CONVEX_SITE_URL": "https://striped-starling-176.eu-west-1.convex.site" },
  "env": {
    "staging": {
      "workers_dev": true,
      "preview_urls": true,
      "routes": [{ "pattern": "staging.udvasito.com", "custom_domain": true }],
      "vars": { "CONVEX_SITE_URL": "https://outstanding-grasshopper-711.eu-west-1.convex.site" },
    },
  },
}
