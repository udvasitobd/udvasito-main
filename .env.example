# .env.example — NAMES ONLY. Never put a real value in this file (the repository is public).
# Real values live in: Convex env (npx convex env set NAME value), Vercel project env, EAS env (expo.dev).
# `npx convex dev` writes CONVEX_DEPLOYMENT / EXPO_PUBLIC_CONVEX_URL / EXPO_PUBLIC_CONVEX_SITE_URL into .env.local
# (git-ignored) for local development.

# --- App (public — bundled into the web app and APK; never secrets) --- Vercel + EAS + .env.local
CONVEX_DEPLOYMENT=
EXPO_PUBLIC_CONVEX_URL=
EXPO_PUBLIC_CONVEX_SITE_URL=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_APP_ENV=
EXPO_PUBLIC_VAPID_PUBLIC_KEY=

# --- Build only --- EAS / Vercel
EAS_PROJECT_ID=
GOOGLE_SERVICES_JSON=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Server secrets --- Convex env only (staging and production have different values)
BETTER_AUTH_SECRET=
SITE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
SENTRY_DSN=
